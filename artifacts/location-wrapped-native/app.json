{
  "expo": {
    "name": "Location Wrapped",
    "slug": "location-wrapped-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "location-wrapped-native",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location Wrapped records your location while the app is open so you can build your personal place history."
      }
    },
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-location", {
        "locationWhenInUsePermission": "Location Wrapped records your location while the app is open so you can build your personal place history.",
        "isAndroidBackgroundLocationEnabled": false,
        "isIosBackgroundLocationEnabled": false
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
